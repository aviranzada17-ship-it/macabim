# העתיקו קובץ זה ל-.env ומלאו את הערכים.

# בפיתוח מקומי: כתובת מקומית מ-`npx prisma dev -d --name mechabim`
# בפרודקשן: כתובת ה-"Connection pooling" (transaction mode, פורט 6543) מ-Supabase → Connect → ORMs
DATABASE_URL="postgres://postgres:postgres@localhost:5432/template1?sslmode=disable"

# נדרש רק בפרודקשן (Supabase) לצורך הרצת מיגרציות - כתובת ה-"Direct connection" (פורט 5432)
# בפיתוח מקומי אפשר להשאיר זהה ל-DATABASE_URL
DIRECT_URL="postgres://postgres:postgres@localhost:5432/template1?sslmode=disable"

# מפתח סודי לחתימת session/JWT - ערך אקראי וארוך (למשל: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret-before-deploying"

# אופציונלי - פרטי משתמש המנהל שייווצר ע"י `npm run db:seed`
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"
